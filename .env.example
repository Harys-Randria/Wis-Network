# Identifiants EmailJS — necessaires au formulaire de contact.
# Copier ce fichier vers .env.local puis renseigner les valeurs reelles.
# Recuperables sur https://dashboard.emailjs.com (voir README, section 3).
# Ces variables sont lues au moment du build : relancer le build apres modification.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
